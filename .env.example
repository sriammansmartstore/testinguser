# ===================================================
# Sri Amman Smart Store - Environment Variables Guide
# ===================================================

# ---------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Client-side)
# Used in Vite browser bundle (prefixed with VITE_)
# ---------------------------------------------------
VITE_ENABLE_ONLINE_PAYMENT=false
VITE_RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
VITE_GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=sri-amman-smart-store.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sri-amman-smart-store
VITE_FIREBASE_PROJECT_NUMBER=1018585256480

# ---------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Vercel Serverless Functions)
# MUST BE KEPT SECRET! Configure in Vercel Project Settings -> Environment Variables
# ---------------------------------------------------
# Razorpay Live / Test Credentials:
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# Firebase Admin SDK Credentials:
# Option A: Individual fields
FIREBASE_PROJECT_ID=sri-amman-smart-store
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@sri-amman-smart-store.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# Option B: Complete Service Account JSON (Alternative to Option A)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"sri-amman-smart-store",...}
