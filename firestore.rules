rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId || request.auth.token.userDocId == userId);
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Public Product Catalog: Read-only for all clients, writes reserved for Admin
    match /products/{category} {
      allow read: if true;
      allow write: if isAdmin();

      match /items/{itemId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Allow collectionGroup query for items (public read)
    match /{path=**}/items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories & Banners: Public read-only
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Store Settings (CoinValue, promos, delivery configs): Public read-only, Admin write
    match /Settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders Collection: High-Security Enforcement
    match /orders/{orderId} {
      // Users can only read their own orders; Admins can read all
      allow read: if isAuthenticated() && (resource.data.buyerUid == request.auth.uid || isAdmin());

      // Client Creation:
      // Allowed for COD orders or client initialization ONLY when paymentStatus is 'Pending'
      // Clients can NEVER set paymentStatus: 'Paid' or status: 'Confirmed'
      allow create: if isAuthenticated()
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.paymentStatus == 'Pending'
        && request.resource.data.status == 'Pending'
        && (request.resource.data.paymentMethod == 'COD' || request.resource.data.paymentMethod == 'Razorpay');

      // Client Updates:
      // Clients CANNOT alter paymentStatus to 'Paid', cannot tamper with total, buyerUid, or payment details.
      // All transitions to 'Paid' or 'Confirmed' are executed exclusively by the backend Admin SDK.
      allow update: if isAuthenticated()
        && resource.data.buyerUid == request.auth.uid
        && request.resource.data.buyerUid == resource.data.buyerUid
        && request.resource.data.total == resource.data.total
        && request.resource.data.amountInPaise == resource.data.amountInPaise
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.paymentStatus != 'Paid';

      allow delete: if isAdmin();
    }

    // User profiles & subcollections
    match /users/{userDocId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();

      // Clients cannot directly tamper with their coin balance or reservations
      allow update: if isAuthenticated() && (
        isAdmin() || (
          // Protect coins and reservedCoins from arbitrary client modifications
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins', 'reservedCoins']))
          || (resource.data.coins == request.resource.data.coins)
        )
      );

      // Cart: Owner can read and modify
      match /cart/{cartItemId} {
        allow read, write: if isAuthenticated();
      }

      // User copy of orders: Read-only for owner, written by backend / order creation
      match /orders/{userOrderId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.resource.data.paymentStatus != 'Paid';
      }

      // Coin History: Read-only for owner, written exclusively by backend
      match /coinHistory/{historyId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      // Notifications, Addresses, Wishlist: Owner full access
      match /notifications/{notifId} {
        allow read, write: if isAuthenticated();
      }
      match /addresses/{addressId} {
        allow read, write: if isAuthenticated();
      }
      match /wishlist/{wishlistId} {
        allow read, write: if isAuthenticated();
      }
    }

    // User ID mapping collection
    match /usersByUid/{uid} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Metadata and Counters (userSequence)
    match /meta/{metaId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
